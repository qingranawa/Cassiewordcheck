<local:AppPage x:Class="CassieWordCheck.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CassieWordCheck.Views.Pages">
    <ScrollViewer>
        <StackPanel MaxWidth="820" Spacing="18">
            <StackPanel Spacing="6"><TextBlock x:Name="TitleTextBlock" Style="{StaticResource PageTitleTextBlockStyle}" /><TextBlock x:Name="SubtitleTextBlock" Style="{StaticResource PageSubtitleTextBlockStyle}" /></StackPanel>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <CheckBox x:Name="IgnoreChineseCheck" />
                    <CheckBox x:Name="FilterFormattingCheck" />
                    <CheckBox x:Name="FilterNamingCheck" />
                    <CheckBox x:Name="WordWrapCheck" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="LanguageLabel" />
                    <ComboBox x:Name="LanguageCombo" SelectionChanged="OnLanguageChanged" />
                    <TextBlock x:Name="FontSizeLabel" />
                    <ComboBox x:Name="FontSizeCombo" />
                    <TextBlock x:Name="WordlistPathLabel" />
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="WordlistPathBox" /><Button x:Name="BrowseButton" Grid.Column="1" Click="OnBrowse" Style="{StaticResource SecondaryButtonStyle}" /></Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ResetButton" Click="OnReset" Style="{StaticResource SecondaryButtonStyle}" /><Button x:Name="UpdateButton" Click="OnCheckUpdate" Style="{StaticResource SecondaryButtonStyle}" /><Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource AccentButtonStyle}" /></StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:AppPage>
