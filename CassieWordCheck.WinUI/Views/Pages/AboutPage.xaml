<local:AppPage x:Class="CassieWordCheck.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CassieWordCheck.Views.Pages">
    <ScrollViewer>
        <StackPanel MaxWidth="900" Spacing="18">
            <StackPanel Spacing="6"><TextBlock x:Name="TitleTextBlock" Style="{StaticResource PageTitleTextBlockStyle}" /><TextBlock x:Name="SubtitleTextBlock" Style="{StaticResource PageSubtitleTextBlockStyle}" /></StackPanel>
            <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><TextBlock x:Name="VersionTextBlock" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" /><Button x:Name="GitHubButton" Click="OnGitHub" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></Border>
            <ComboBox x:Name="SectionCombo" SelectionChanged="OnSectionChanged" />
            <Border Style="{StaticResource CardBorderStyle}"><TextBlock x:Name="ContentTextBlock" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Border>
        </StackPanel>
    </ScrollViewer>
</local:AppPage>
