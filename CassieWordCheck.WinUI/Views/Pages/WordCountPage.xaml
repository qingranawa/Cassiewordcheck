<local:AppPage x:Class="CassieWordCheck.Views.Pages.WordCountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CassieWordCheck.Views.Pages">
    <ScrollViewer>
        <StackPanel MaxWidth="1040" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TitleTextBlock" Style="{StaticResource PageTitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleTextBlock" Style="{StaticResource PageSubtitleTextBlockStyle}" />
            </StackPanel>
            <TextBox x:Name="InputBox" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" TextChanged="OnTextChanged" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="TotalCharsLabel" /><TextBlock x:Name="TotalCharsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="CharsNoSpacesLabel" /><TextBlock x:Name="CharsNoSpacesValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="ChineseCharsLabel" /><TextBlock x:Name="ChineseCharsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="EnglishLettersLabel" /><TextBlock x:Name="EnglishLettersValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="TotalWordsLabel" /><TextBlock x:Name="TotalWordsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="UniqueWordsLabel" /><TextBlock x:Name="UniqueWordsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="AvgLengthLabel" /><TextBlock x:Name="AvgLengthValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="TotalLinesLabel" /><TextBlock x:Name="TotalLinesValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="TopWordsTitle" FontWeight="SemiBold" /><StackPanel x:Name="TopWordsPanel" Margin="0,10,0,0" Spacing="6" /><TextBlock x:Name="LengthTitle" Margin="0,18,0,0" FontWeight="SemiBold" /><StackPanel x:Name="LengthPanel" Margin="0,10,0,0" Spacing="6" /></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</local:AppPage>
