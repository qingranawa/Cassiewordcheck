<local:AppPage x:Class="CassieWordCheck.Views.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CassieWordCheck.Views.Pages">
    <ScrollViewer>
        <StackPanel MaxWidth="1040" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TitleTextBlock" Style="{StaticResource PageTitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleTextBlock" Style="{StaticResource PageSubtitleTextBlockStyle}" />
            </StackPanel>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="ChecksLabel" /><TextBlock x:Name="ChecksValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="AverageLabel" /><TextBlock x:Name="AverageValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="LowestLabel" /><TextBlock x:Name="LowestValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock x:Name="UnavailableLabel" /><TextBlock x:Name="UnavailableValue" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>
            <ComboBox x:Name="ViewSelector" SelectionChanged="OnViewChanged" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel x:Name="TrendPanel" Spacing="10" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:AppPage>
