<local:AppPage x:Class="CassieWordCheck.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CassieWordCheck.Views.Pages">
    <ScrollViewer>
        <StackPanel MaxWidth="1040" Spacing="18">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TitleTextBlock" Style="{StaticResource PageTitleTextBlockStyle}" />
                    <TextBlock x:Name="SubtitleTextBlock" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                </StackPanel>
                <Button x:Name="ClearButton" Grid.Column="1" Click="OnClear" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
            <TextBlock x:Name="EmptyTextBlock" Style="{StaticResource PageSubtitleTextBlockStyle}" />
            <ListView x:Name="HistoryList" SelectionMode="None" BorderThickness="0" />
        </StackPanel>
    </ScrollViewer>
</local:AppPage>
