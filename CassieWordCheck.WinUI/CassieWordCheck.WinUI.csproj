<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 默认生成可验证的未签名 MSIX，发布流水线可通过证书属性启用签名。 -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateTemporaryStoreCertificate>false</GenerateTemporaryStoreCertificate>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <Version>2.5.0</Version>
    <FileVersion>2.5.0.0</FileVersion>
    <AssemblyName>CassieWordCheck</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CassieWordCheck.Core\CassieWordCheck.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <Compile Include="..\Views\AboutWindow.xaml.cs" Link="Migration\AboutWindowChangelog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\data\cassie-text.txt" Link="data\cassie-text.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Resources\Locales\*.json" Link="Resources\Locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
