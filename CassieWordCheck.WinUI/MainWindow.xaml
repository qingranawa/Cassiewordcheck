<Window x:Class="CassieWordCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CASSIE CWC Tool">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <NavigationView x:Name="RootNavigationView"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="OnNavigationSelectionChanged"
                        PaneDisplayMode="LeftCompact">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="HistoryNavigationItem" Tag="history">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Page" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="StatisticsNavigationItem" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="FourBars" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WordCountNavigationItem" Tag="wordcount">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WordListNavigationItem" Tag="wordlist">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavigationItem" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavigationItem" Tag="about">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid Padding="24,18,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame x:Name="ContentFrame" Grid.Row="0" />
                    <InfoBar x:Name="GlobalInfoBar"
                             Grid.Row="1"
                             Margin="0,14,0,0"
                             IsOpen="False"
                             IsClosable="True" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
